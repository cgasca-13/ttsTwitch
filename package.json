{
  "name": "ttstwitch",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "node scripts/electron-dev.cjs",
    "build": "next build",
    "start": "next start",
    "start:desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --win nsis",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.ttstwitch.app",
    "productName": "TTS Twitch Bot",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.49.0",
    "tmi.js": "^1.8.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
